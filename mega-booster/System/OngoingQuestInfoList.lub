QuestInfoList = {
	[18029] = {
		Title = "Lv1 - Let's Hunt Fabre!",
		Description = {
			"Fabre are often found around Geffen and Prontera. Try hunting a few. Report to Lime by using your Booster Call when you're done.",
		},
		Summary = "Hunt Fabre",
		IconName = "ico_nq.bmp",
		RewardEXP = "3159",
		RewardJEXP = "1299",
	},
	[18031] = {
		Title = "Lv11 - Payon Field Expedition",
		Description = {
			"Explore the forests and fields around Payon and build up your skills. Report to Lime by using your Booster Call when you're done.",
		},
		Summary = "Hunt monsters around Payon",
		IconName = "ico_nq.bmp",
		RewardEXP = "10760",
		RewardJEXP = "7378",
	},
	[18033] = {
		Title = "Lv20 - Culvert Expedition",
		Description = {
			"Explore the Prontera Culvert and build up your skills. Sign up for the Culvert subjugation with the <NAVI>[Knight Recruiter]<INFO>prt_in,88,105,0,101,0,</INFO></NAVI> in Prontera, then head to the Culvert entrance. Report to Lime by using your Booster Call when you're done.",
		},
		Summary = "Hunt monsters in the Culvert",
		IconName = "ico_nq.bmp",
		RewardEXP = "39420",
		RewardJEXP = "10260",
	},
	[18035] = {
		Title = "Lv35 - Mjolnir Dead Pit Expedition",
		Description = {
			"Explore the <NAVI>[abandoned mine]<INFO>mjo_dun01,52,23,0,101,0,</INFO></NAVI> in the Mjolnir foothills north of <NAVI>[Geffen]<INFO>geffen,119,72,0,101,0,</INFO></NAVI>. Careful: go too deep and you may get lost. Report to Lime by using your Booster Call when you're done.",
		},
		Summary = "Hunt monsters in the Dead Pit",
		IconName = "ico_nq.bmp",
		RewardEXP = "47980",
		RewardJEXP = "36738",
	},
	[18037] = {
